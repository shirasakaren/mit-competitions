# Copy to .env and fill in real values. Never commit the real .env.

# --- PostgreSQL ---
POSTGRES_USER=cip
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=challenge_db

# --- Backend ---
RUST_LOG=info
DB_POOL_MIN=20
DB_POOL_MAX=50

# --- Cloudflare (only needed for DNS/TLS automation scripts, not by the app) ---
CLOUDFLARE_ID=
CLOUDFLARE_TOKEN=

# --- AWS (only needed for optional backup/DNS automation scripts, not by the app) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
