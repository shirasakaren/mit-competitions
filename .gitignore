# Secrets - NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# Dataset dump (5GB+, lives on VPS at /app/data)
*.sql.gz
*.sql
challenge_db_anonymized_v2.sql.gz
challenge_db_anonymized_v3.sql.gz
challenge_db_anonymized_v3.sql

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node / frontend
node_modules/
dist/
build/
.vite/
*.local

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Load test results (keep summarized in PERFORMANCE.md, not raw dumps)
loadtest/results/*.json
loadtest/results/*.txt

# But keep the small benchmark/verification SQL under scripts/ (the *.sql
# rule above exists only to exclude the multi-GB dataset dump)
!scripts/*.sql

# Raw (unoptimized) screen captures stay local; the README uses media/optimized/
media/*.mov
media/Screenshot*.png
